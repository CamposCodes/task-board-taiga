# Address of the Taskboard API (with or without /api/v1).
TASKBOARD_URL=https://taskboard.example.com
# Personal API token: log in (Keycloak or local), open "Perfil e tokens de API" and create one.
# A read-only token hides the write tools.
TASKBOARD_TOKEN=tb_...
# Optional: set to 1 to hide the write tools even when the token can write.
# TASKBOARD_READ_ONLY=1
