# Copy to .env and fill in. The .env file is not versioned.

# Name users type in the browser. With public DNS, Caddy obtains the certificate automatically.
DOMAIN=taskboard.example.com

# Intranet name without public DNS: let Caddy sign with its own authority (browsers must trust it),
# or point to your certificate: TLS_DIRECTIVE=tls /certs/cert.pem /certs/key.pem (mount them in caddy).
# TLS_DIRECTIVE=tls internal

# Only if the address differs from https://DOMAIN (e.g. a non-standard port).
# PUBLIC_URL=https://taskboard.example.com:8443
# HTTP_PORT=80
# HTTPS_PORT=443

# Database password (any long random text).
DB_PASSWORD=

# Signs the session cookies. At least 32 characters: openssl rand -base64 48
APP_JWT_SECRET=

# Password of the user "admin", created on the first start only. Empty = random, printed in the app log.
APP_ADMIN_PASSWORD=

# Login through Keycloak (OpenID Connect). Leave OIDC_ISSUER empty to use only local passwords.
# In Keycloak: client "taskboard", confidential, standard flow, valid redirect URI
#   https://DOMAIN/api/v1/auth/oidc/callback
# Keycloak 17+: https://keycloak.example.com/realms/REALM   older: .../auth/realms/REALM
OIDC_ISSUER=
OIDC_CLIENT_ID=taskboard
OIDC_CLIENT_SECRET=
# Text of the button: "Entrar com <label>"
OIDC_LABEL=Keycloak

TIME_ZONE=America/Sao_Paulo

# Largest attachment accepted. Above 20MB, raise max_size in the Caddyfile too.
# MAX_UPLOAD=20MB

# E-mail of every movement in the projects. Leave MAIL_HOST empty to send none.
# Product owners and project leaders get everything; the others only what they are assigned to, watch or created.
# Port 587 uses STARTTLS when the server offers it; for port 465 set MAIL_SSL=true.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
# MAIL_SSL=false
# Sender of the messages. Most servers only accept an address of their own domain.
MAIL_FROM=taskboard@example.com
